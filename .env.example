# ════════════════════════════════════════════════════════════════════════════
# AFHO .env.example — every name the scripts read, minus secrets.
# Copy to .env and fill in. `.env` is gitignored — never commit keys or the
# Telegram session string. Names only below; commented = optional/override.
# ════════════════════════════════════════════════════════════════════════════

# ── announcement bot (scripts/keeper/twitter-announcer.ts) ──────────────────
# channel switches ("false" disables a channel)
X_ENABLED=true
TG_ENABLED=false

# X (Twitter) — developer portal → "Keys and tokens". Posting as your own
# account needs the OAuth 1.0a *user context* pair (X_ACCESS_TOKEN +
# X_ACCESS_TOKEN_SECRET) plus the app consumer key/secret.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Telegram (Bot API) — @BotFather /newbot → bot token; add the bot as ADMIN
# of the announcement channel with "Post messages", then TG_ENABLED=true.
TELEGRAM_BOT_TOKEN=
# Channel to post into: @username or -100… numeric id.
TELEGRAM_CHANNEL_ID=

# ── shared ───────────────────────────────────────────────────────────────────
# "true" logs the post text instead of hitting X / Telegram.
DRY_RUN=false
# Poll cadence in milliseconds (default 60000).
POLL_INTERVAL_MS=60000
# RPC endpoint (keeper prefers this over the cluster default).
RPC_URL=

# ── Launch knobs (the ONLY launch config) ──────────────────────────────────
# Deploy wizard: `anchor run deploy` (fresh wallets + funding bars + the full
# chain + keeper/manifest). Rehearse the whole flow on devnet with
# DEPLOY_CLUSTER=devnet; gates-only with `anchor run deploy -- --dry`.
# Supply is FINALIZED (never config): 1B total, 20% (200M) to the pool seed.
# The 3% buy is FINALIZED too: it rides INSIDE the launch bundle
# (launch-bundle.ts — pool creation + buy + 3×5M staked+FROZEN lots with the
# other ~15M liquid in the buy wallet, atomic on mainnet), spending
# 0.18 × USDC_TO_LP. The freeze legs need an OPEN session: launch inside NYSE
# hours. USDC_TO_LP is the ONE adjustable knob: it sets the launch price
# (200M AFHO : USDC_TO_LP USDC) and drives the buy wallet's USDC need.
USDC_TO_LP=2000
# Buy wallet (base58 secret or JSON byte array) — signs ONLY the bundle's buy
# + stake/freeze txs. Fund it with ≥ 0.18 × USDC_TO_LP USDC and ~0.03 SOL
# (fees + 4 stake-account rents); `anchor run prep` prints the exact numbers.
BUYER_WALLET_KEY=
# Jito tip for the launch bundle (SOL) — execution detail, not launch economics.
# JITO_TIP_SOL=0.01
# Override the Jito block engine (lib/jito.ts; default is the public mainnet one).
# JITO_BLOCK_ENGINE=
# burn-lp rehearsal escape hatch — NOT set for the real launch (burn is default-on).
# SKIP_BURN=1
# Pin a specific pool instead of deriving from deployment.json (set-cpmm-pool;
# burn-lp reads RAYDIUM_LP_MINT the same way).
# RAYDIUM_POOL=
# RAYDIUM_AMM_CONFIG=
# RAYDIUM_PROGRAM=
# RAYDIUM_LP_MINT=
# amm-init pins the protocol authority here when it should differ from the
# provider wallet (rehearsals leave it unset).
# LAUNCH_AUTHORITY=

# ── Authority ops (Anchor.toml [scripts] entries — see AGENTS.md) ───────────
# rotate-authorities: NEW_AUTHORITY=<vault pubkey> WHICH=crank|amm|staking|calendar
# NEW_AUTHORITY=
# WHICH=
# set-keeper: KEEPER=<pubkey>
# KEEPER=
# check-authorities guards:
# EXPECTED_AUTHORITY=
# EXPECTED_CALENDAR=
# set-halt-pools (re-pin the real SPYx venues):
# HALT_POOLS=
# spyx-layout: POOLS=<poolA,poolB>

# ── Keeper (VPS units) ──────────────────────────────────────────────────────
# mev-keeper-mainnet bounty top-up sweep (lamports):
# BOUNTY_RECYCLE=
# announcer X API base override (e.g. mock in tests):
# X_API_BASE=
